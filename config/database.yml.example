# Mysql configurations
default: &default
  host: localhost
  port: 3306
  adapter: mysql2
  encoding: utf8
  collation: utf8_unicode_ci
  username: root
  password: letmein
  pool: <%= ENV.fetch("RAILS_MAX_THREADS") { 20 } %>
  checkout_timeout: 5000
  variables:
    sql_mode: traditional

development:
  primary: 
    <<: *default
    database: openmrs_dev
  queue:
    <<: *default
    database: queue_dev
    migrations_paths: []
    processing_delay_time: 10:

test:
  primary:
    <<: *default
    database: khulambe_test
  queue:
    <<: *default
    database: queue_test
    migrations_paths: []
    processing_delay_time: 10

production:
  primary:
    <<: *default
    database: openmrs_prod
  queue:
    <<: *default
    database: queue_prod
    migrations_paths: []
    processing_delay_time: 10

