# Mysql configurations
default: &default
  host: localhost
  port: 3306
  adapter: mysql2
  encoding: utf8
  collation: utf8_unicode_ci
  username: root
  password: letmein
  pool: <%= ENV.fetch("RAILS_MAX_THREADS") { 20 } %>
  checkout_timeout: 5000
  variables:
    sql_mode: traditional

development:
  primary: 
    <<: *default
    database: openmrs_limbe
  queue:
    <<: *default
    database: openmrs_limbe
    migration_paths: db/migrate
    processing_delay_time: 300:

test:
  <<: *default
  database: openmrs

production:
  <<: *default
  database: openmrs_kawale

